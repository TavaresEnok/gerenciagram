{
  "name": "gerenciador-redes-sociais",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "db:generate": "pnpm --filter @app/db exec prisma generate",
    "db:migrate": "pnpm --filter @app/db exec prisma migrate dev",
    "db:deploy": "pnpm --filter @app/db exec prisma migrate deploy",
    "db:studio": "pnpm --filter @app/db exec prisma studio",
    "db:seed": "pnpm --filter @app/db run seed",
    "docker:up": "docker compose -f infra/docker/docker-compose.yml --env-file .env up -d",
    "docker:down": "docker compose -f infra/docker/docker-compose.yml --env-file .env down",
    "docker:logs": "docker compose -f infra/docker/docker-compose.yml logs -f",
    "docker:reset": "docker compose -f infra/docker/docker-compose.yml --env-file .env down -v",
    "db:deploy:test": "node infra/scripts/deploy-test-db.mjs",
    "worker:check": "node infra/scripts/worker-boot-check.mjs",
    "load:api": "node infra/scripts/api-for-load-test.mjs",
    "load:test": "node infra/scripts/load-test.mjs http://localhost:3002"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.5",
    "dotenv": "^16.4.7",
    "eslint": "^9.18.0",
    "globals": "^17.13.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^2.1.8"
  }
}
