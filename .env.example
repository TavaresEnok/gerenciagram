# ============================================================================
#  Gerenciador de Redes Sociais — variáveis de ambiente
#  Copie para `.env` e preencha. NUNCA commite o `.env`.
# ============================================================================

NODE_ENV=development
APP_ENV=development          # development | staging | production
LOG_LEVEL=debug              # trace | debug | info | warn | error

# ----------------------------------------------------------------------------
#  Rede Docker (evita conflito de IP com a LAN e com o switch do Hyper-V)
#
#  Faixas JÁ EM USO nesta máquina — não usar:
#    192.168.68.0/22   Wi-Fi (LAN)
#    172.22.144.0/20   vEthernet (Default Switch / Hyper-V)
#    192.168.65.0/24   rede interna da VM do Docker Desktop
#
#  Ver DEPLOYMENT.md > "Conflito de IP" antes de alterar.
# ----------------------------------------------------------------------------
DOCKER_SUBNET=10.201.10.0/24
DOCKER_GATEWAY=10.201.10.1

# Endereço de bind no host. 127.0.0.1 mantém o ambiente de dev fora da rede Wi-Fi.
BIND_ADDR=127.0.0.1

# Portas expostas no host (escolhidas fora dos padrões para não colidir
# com um Postgres/Redis instalado nativamente).
API_PORT=3001
WEB_PORT=3000
POSTGRES_PORT=5433
REDIS_PORT=6380
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# ----------------------------------------------------------------------------
#  Banco de dados
# ----------------------------------------------------------------------------
POSTGRES_USER=gerenciador
POSTGRES_PASSWORD=troque_esta_senha_no_env_local
POSTGRES_DB=gerenciador

# Host = "postgres" dentro do compose; "localhost" ao rodar a API no host.
DATABASE_URL=postgresql://gerenciador:troque_esta_senha_no_env_local@localhost:5433/gerenciador?schema=public
# Usado pelos containers de api/worker (resolve pelo DNS interno do compose):
DATABASE_URL_DOCKER=postgresql://gerenciador:troque_esta_senha_no_env_local@postgres:5432/gerenciador?schema=public

# ----------------------------------------------------------------------------
#  Redis / filas (BullMQ)
# ----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6380
REDIS_URL_DOCKER=redis://redis:6379
QUEUE_PREFIX=grs

# ----------------------------------------------------------------------------
#  Storage S3-compatible (MinIO em dev; S3/R2 em produção)
# ----------------------------------------------------------------------------
STORAGE_DRIVER=s3                 # s3 | local
S3_ENDPOINT=http://localhost:9000
S3_ENDPOINT_DOCKER=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=gerenciador-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=troque_esta_senha_no_env_local
S3_FORCE_PATH_STYLE=true
# URL pública para o navegador baixar mídia (presigned URLs)
S3_PUBLIC_URL=http://localhost:9000

# ----------------------------------------------------------------------------
#  Segurança / criptografia
#
#  Gere cada segredo com:  openssl rand -base64 48
#  ENCRYPTION_KEY precisa ser exatamente 32 bytes em base64 (openssl rand -base64 32)
#  — é a chave AES-256-GCM que cifra os tokens OAuth em repouso.
# ----------------------------------------------------------------------------
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ENCRYPTION_KEY=
ACCESS_TOKEN_TTL=900              # segundos (15 min)
REFRESH_TOKEN_TTL=2592000         # segundos (30 dias)
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false               # true em staging/produção (HTTPS)

# 2FA (TOTP)
TOTP_ISSUER=Gerenciador de Redes Sociais

# Rate limiting da API própria
RATE_LIMIT_MAX=300                # requisições
RATE_LIMIT_WINDOW=60000           # janela em ms

# ----------------------------------------------------------------------------
#  URLs públicas
# ----------------------------------------------------------------------------
API_PUBLIC_URL=http://localhost:3001
WEB_PUBLIC_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# ATENÇÃO: Meta e TikTok NÃO aceitam http://localhost como redirect URI de OAuth.
# Para essas redes é preciso um túnel HTTPS público (Cloudflare Tunnel / ngrok)
# e apontar OAUTH_PUBLIC_URL para ele. Ver SOCIAL_INTEGRATIONS.md.
OAUTH_PUBLIC_URL=http://localhost:3001

# ----------------------------------------------------------------------------
#  E-mail (Mailpit em dev — captura tudo, não envia de verdade)
# ----------------------------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
MAIL_FROM="Gerenciador <nao-responda@localhost>"

# ----------------------------------------------------------------------------
#  Observabilidade
# ----------------------------------------------------------------------------
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=gerenciador-api

# --- Alertas operacionais ---------------------------------------------------
# O worker avalia as métricas técnicas a cada 5 min e dispara quando passam
# destes limiares. Todo alerta vai para o LOG em nível de erro (é o canal que
# qualquer coletor capta); o e-mail é adicional e só sai se ALERT_EMAIL estiver
# preenchido — sem destinatário o sistema não inventa um.
#
# Os números abaixo são ponto de partida: calibre com o volume real.
ALERT_EMAIL=
ALERT_FAILURE_RATE_PERCENT=25     # % de falha por plataforma em 24h
ALERT_FAILURE_MIN_SAMPLE=10       # publicações mínimas para a taxa valer
ALERT_DEAD_LETTER_OPEN=10         # jobs na dead-letter sem resolução
ALERT_QUEUE_WAITING=500           # jobs esperando numa fila
ALERT_ACCOUNTS_NEEDING_RECONNECT=5
ALERT_COOLDOWN_MINUTES=60         # silêncio do mesmo alerta após disparar

# ----------------------------------------------------------------------------
#  Processamento de vídeo
# ----------------------------------------------------------------------------
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
MEDIA_MAX_UPLOAD_BYTES=524288000  # 500 MB

# ============================================================================
#  CREDENCIAIS DE PLATAFORMA (PENDENTES — só o dono do projeto pode criar)
#
#  Cada bloco abaixo está VAZIO de propósito. Enquanto estiver vazio, a
#  plataforma correspondente aparece como "não configurada" na UI e o sistema
#  se recusa a fingir que publica. Ver SOCIAL_INTEGRATIONS.md para o passo a
#  passo de obtenção de cada credencial.
# ============================================================================

# --- YouTube / Google (plataforma escolhida para a Fase 0) ------------------
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web)
# Redirect URI a cadastrar: ${OAUTH_PUBLIC_URL}/v1/oauth/youtube/callback
# Aceita http://localhost — é a única rede que valida sem túnel HTTPS.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Cota diária de UPLOADS do PROJETO no Google Cloud — não por conta, e sim
# compartilhada por todos os clientes do SaaS (ver seção 12 da SPEC).
#
# O YouTube usa buckets granulares: 100 chamadas videos.insert/dia, mais 100
# search.list/dia, mais 10.000 unidades/dia para os demais endpoints.
YOUTUBE_PROJECT_DAILY_QUOTA=100

# --- Meta (Instagram + Facebook) -------------------------------------------
# Exige App Review + verificação de negócio + conta IG Business/Creator.
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=v21.0
# Token que você escolhe e cadastra no console da Meta, no painel de webhooks.
# Sem ele, os webhooks da Meta são recusados com 501 em vez de aceitos sem verificação.
META_WEBHOOK_VERIFY_TOKEN=

# --- TikTok ----------------------------------------------------------------
# Direct Post exige audit do app. Sem audit, o conteúdo entra como rascunho.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# --- X (Twitter) -----------------------------------------------------------
# API paga. A política proíbe conteúdo duplicado em múltiplas contas.
X_CLIENT_ID=
X_CLIENT_SECRET=

# --- Kwai ------------------------------------------------------------------
# Sem API oficial de publicação para terceiros confirmada. Ver
# SOCIAL_INTEGRATIONS.md; enquanto não houver, a rede fica indisponível na UI.
KWAI_CLIENT_ID=
KWAI_CLIENT_SECRET=

# ----------------------------------------------------------------------------
#  Módulo de IA Universal Híbrido (Opcional)
#  Suporta:
#   1. Provedores OpenAI-compatíveis: Gemini (via Google AI Studio), OpenRouter, Ollama, OpenAI, Groq
#   2. Anthropic Claude
#   3. Gerador Local Heurístico: Sem chave no .env, o sistema gera rascunhos locais sem custo.
# ----------------------------------------------------------------------------
# Exemplo Gemini via OpenAI endpoint: https://generativelanguage.googleapis.com/v1beta/openai/
# Exemplo OpenRouter: https://openrouter.ai/api/v1
# Exemplo Ollama local: http://localhost:11434/v1
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=gemini-2.0-flash
ANTHROPIC_API_KEY=
